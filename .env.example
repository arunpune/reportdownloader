# -----------------------------
# Application
# -----------------------------
APP_NAME=Test Report Portal
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
DEBUG=true

# -----------------------------
# PostgreSQL
# -----------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/test_reports

# -----------------------------
# Report source / storage / ingestion
# -----------------------------

SOURCE_REPORT_ROOT="D:/path/to/REPORTS/EXCEL/SINGLE DUT REPORT"

STORAGE_DIR=report_storage

# Temporary compatibility setting.
# Will be removed once recipe-based ingestion is enabled.


FILE_STABILITY_SECONDS=2
INGESTION_POLL_SECONDS=2
ALLOWED_REPORT_EXTENSIONS=.xlsx

# Reports displayed on one page.
# Change this without changing application code.
REPORTS_PER_PAGE=100

# -----------------------------
# Session / security
# -----------------------------
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_SECONDS=28800

# -----------------------------
# Demo seed
# -----------------------------
SEED_DEMO_DATA=true
DEMO_COMPANY_NAME=TVS Motor
DEMO_COMPANY_CODE=TVS
DEMO_ADMIN_EMAIL=admin@tvs-demo.local
DEMO_ADMIN_PASSWORD=ChangeMe123!
DEMO_USER_EMAIL=user@tvs-demo.local /user@mahindra-demo.local
DEMO_USER_PASSWORD=ChangeMe123!
DEMO_SUPER_ADMIN_EMAIL=superadmin@portal-demo.local
DEMO_SUPER_ADMIN_PASSWORD=ChangeMe123!
